# LJS runtime environment variables
# Most application settings are configured through the setup wizard,
# ignored config/settings.local.yaml, or ignored config/categories/<category_id>.yaml.
# Public defaults live in config/settings.template.yaml and
# config/category-config-templates/*.yaml.

# Server binding
LJS_PORT=8088
LJS_HOST=0.0.0.0
LJS_ACCESS_LOGS=quiet

# Web auth token signing secret. Set this in production.
LJS_WEB_SECRET=change-me-in-production-random-secret

# Development only. run.sh/run.bat set this automatically for local smoke runs.
LJS_ALLOW_INSECURE_DEV=1

# Configure LLM providers, Jackett, web-search APIs, category paths, and optional
# integrations in the UI or YAML files rather than through environment variables.

# ─── Local MCP integration (opt-in) ───────────────────────────
# Mounts a Streamable-HTTP MCP endpoint at /mcp inside the existing LJS process.
# Local MCP v1 accepts ONLY this dedicated bearer token; ordinary LJS Web JWTs
# are not MCP credentials. Tokens must be at least 32 characters.
LJS_MCP_ENABLED=0
LJS_MCP_TOKEN=
LJS_MCP_PRINCIPAL_ID=mcp-local
# Canonical LJS user whose preferences/history should be used by delegated agent turns.
LJS_MCP_USER_ID=local
# Configured local client identity. Local v1 supports one dedicated credential/client tuple at a time.
LJS_MCP_CLIENT_ID=mcp-local
# Default is read/delegate only. Delegated agent calls still default to
# allow_actions=false even when write capabilities are granted here.
# Additional capabilities include:
#   library.write, library.files.delete, downloads.write, tracking.write,
#   config.write, config.llm.probe, config.llm.write,
#   config.llm.endpoint.write, admin
LJS_MCP_CAPABILITIES=agent.delegate,agent.read,status.read,library.read,downloads.read,config.llm.read,diagnostics.read
